{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../@RUTUJEKWIELKI/util"
    },
    {
      "path": "../@RUTUJEKWIELKI/rest"
    },
    {
      "path": "../@RUTUJEKWIELKI/ws"
    },
    {
      "path": "../@RUTUJEKWIELKI/collection"
    },
    {
      "path": "../@RUTUJEKWIELKI/builders"
    },
    {
      "path": "../@RUTUJEKWIELKI/formatters"
    }
  ]
}
