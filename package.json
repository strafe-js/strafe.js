{
  "name": "strafebot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript libraries for the Strafe Chat API and Gateway",
  "workspaces": [
    "packages/*",
    "packages/@RUTUJEKWIELKI/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/@RUTUJEKWIELKI/*/dist"
  },
  "engines": {
    "node": ">=18"
  },
