{
  "name": "strafebot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript libraries for the Strafe Chat API and Gateway",
  "workspaces": [
    "packages/*",
    "packages/@strafe-js/*"
  ],
  "scripts": {
    "build": "npm run build:util && npm run build:collection && npm run build:formatters && npm run build:builders && npm run build:rest && npm run build:ws && npm run build:client",
    "build:util": "npm run build -w @strafe-js/util",
    "build:collection": "npm run build -w @strafe-js/collection",
    "build:formatters": "npm run build -w @strafe-js/formatters",
    "build:builders": "npm run build -w @strafe-js/builders",
    "build:rest": "npm run build -w @strafe-js/rest",
    "build:ws": "npm run build -w @strafe-js/ws",
    "build:client": "npm run build -w @strafe-js/strafebot",
    "clean": "rm -rf packages/*/dist packages/@strafe-js/*/dist"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12"
  }
}
